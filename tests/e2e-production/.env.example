# Copy to tests/e2e-production/.env and fill in — NEVER commit the .env file.
# The root .gitignore already covers .env files.
#
# Required: a real confirmed account on the production site.
E2E_USER_EMAIL=your@email.com
E2E_USER_PASSWORD=yourpassword

# Optional: override the target URL (defaults to https://dc-project-web.vercel.app)
# E2E_BASE_URL=https://dc-project-web.vercel.app

# Optional: UUID of a known public class to test /class/[id] without login.
# Leave blank to skip that test.
# E2E_PUBLIC_CLASS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: set to "true" only if the test user has at least one class
# they TEACH visible in the Global feed. Enables the own-class CTA check.
# Leave blank to skip gracefully.
# E2E_EXPECT_OWN_CLASS=true
