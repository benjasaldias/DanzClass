# Copy this file to tests/e2e/.env, then fill in with a real test-user account.
# Never commit the .env file — it is already in .gitignore.
#
# The test user must have:
#   - A confirmed email (Supabase auth)
#   - At least 1 class they TEACH  (for class navigation tests)
#   - At least 1 class they are ENROLLED in
#   - A basic or pro subscription (to access /publish and /agenda)
#   - Optionally: at least 1 video post with a description (for PostCard tests)
#
# To create a suitable account:
#   1. Register at http://localhost:3000/auth/register
#   2. Confirm the email
#   3. Subscribe to a plan at /plans
#   4. Publish at least one class at /create-class
#   5. Enroll in another class (or enroll from a second account)

E2E_USER_EMAIL=your_test_user@example.com
E2E_USER_PASSWORD=your_password_here
