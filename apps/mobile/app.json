{
  "expo": {
    "name": "DanzClass",
    "slug": "danzclass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../../assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A1035"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.danceclass.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DanzClass necesita acceso a tus fotos para subir imágenes de clase, foto de perfil y comprobantes de pago.",
        "NSPhotoLibraryAddUsageDescription": "DanzClass puede guardar fotos en tu galería.",
        "NSLocationWhenInUseUsageDescription": "DanzClass usa tu ubicación para mostrarte clases de baile cercanas, ordenadas por distancia.",
        "NSCameraUsageDescription": "DanzClass usa la cámara para escanear el código QR de asistencia de tus alumnos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../../assets/adaptive-icon.png",
        "backgroundColor": "#c026d3"
      },
      "package": "cl.danceclass.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "../../assets/icon.png",
          "color": "#c026d3",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "DanzClass"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1035",
          "image": "../../assets/splash.png",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DanzClass necesita acceso a tus fotos para subir imágenes de clase, foto de perfil y comprobantes de pago."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DanzClass usa tu ubicación para mostrarte clases de baile cercanas, ordenadas por distancia."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DanzClass usa la cámara para escanear el código QR de asistencia de tus alumnos."
        }
      ]
    ],
    "scheme": "danceclass",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4cf46d7a-bcac-4fff-ae1f-4f032b520c99"
      }
    },
    "owner": "benjasaldias"
  }
}
